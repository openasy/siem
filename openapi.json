    "/api/v1/signals": {
      "get": {
        "operationId": "listSignals",
        "tags": [
          "Signals"
        ],
        "summary": "List signals",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "A signal is what one rule found on one host within a window (60 minutes by default): the events are counted, not repeated.\n\nNeeds the viewer role.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "`open` (default) is new and investigating.",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "new",
                "investigating",
                "closed",
                "false-positive"
              ],
              "default": "open"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "description": "Comma-separated severities, such as `critical,high`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "host",
            "in": "query",
            "required": false,
            "description": "Exact host.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rule",
            "in": "query",
            "required": false,
            "description": "A rule's id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The previous page's nextCursor.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Most severe first, then most recent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "viewer"
