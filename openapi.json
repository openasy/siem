{
  "openapi": "3.1.1",
  "info": {
    "title": "OpenAsy SIEM API",
    "version": "0.5.0",
    "summary": "Security events, Sigma detection rules and the signals they raise.",
    "description": "Every screen of siem uses this API, and so can your shippers and scripts (ADR 0014). Within `/api/v1` changes are additive only; anything removed is deprecated first (ADR 0024). Errors use Problem Details (RFC 9457).\n\nSend events with `SIEM_INGEST_TOKEN`. Everything else takes the session of a signed-in person or an API token, and each operation names the role it needs (`x-openasy-role`: viewer, editor, admin; ADR 0003).\n\nSign-in, members and API tokens are under `/api/v1/auth`, provided by [@openasy/auth](https://github.com/openasy/auth#routes).",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This siem"
    }
  ],
  "tags": [
    {
      "name": "Events",
      "description": "What happened on hosts and services, as it arrived."
    },
    {
      "name": "Rules",
      "description": "Sigma rules that turn events into signals."
    },
    {
      "name": "Signals",
      "description": "What the rules found, to investigate and close."
    },
    {
      "name": "Product",
      "description": "Version and overview of this siem."
    }
  ],
  "paths": {
    "/api/v1/events": {
      "post": {
        "operationId": "sendEvents",
        "tags": [
          "Events"
        ],
        "summary": "Send events",
        "security": [
          {
            "ingestToken": []
          },
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "One event, or an array of up to 1000. Events are flat JSON objects. If any event in the request is not valid, none of them is kept and the message names the first.\n\n```bash\ncurl -sf -X POST -H \"Authorization: Bearer $SIEM_INGEST_TOKEN\" -H 'content-type: application/json' \\\n  -d '{\"host\":\"web-1\",\"source\":\"sshd\",\"message\":\"Failed password for root\"}' \\\n  https://siem.example.com/api/v1/events\n```\n\nThe body may be gzipped (`Content-Encoding: gzip`), up to 16 MiB unpacked.\n\nTakes SIEM_INGEST_TOKEN, or an API token with the editor role.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEvents"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Kept, and run through every enabled rule.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsAccepted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "editor"
      },
      "get": {
        "operationId": "searchEvents",
        "tags": [
          "Events"
        ],
        "summary": "Search events",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Needs the viewer role.",
        "parameters": [
          {
            "name": "host",
            "in": "query",
            "required": false,
            "description": "Exact host.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "Exact source.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text in the message or any field.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Events at or after this time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "description": "Events at or before this time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The previous page's nextCursor.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "viewer"
      }
    },
