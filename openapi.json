    },
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "tags": [
          "Product"
        ],
        "summary": "Readiness",
        "description": "Ready while the database answers.",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready to serve.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "tags": [
          "Product"
        ],
        "summary": "Prometheus metrics",
        "security": [],
        "responses": {
          "200": {
            "description": "Metrics in the Prometheus text format.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-openasy-session",
        "description": "The browser session after signing in (`openasy-session` when siem runs on plain http://localhost). Requests that change something must come from the siem origin."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token created under Settings \u2192 API tokens (`oa_siem_...`): one role, always an expiry (ADR 0003)."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only when siem is started by its tests or a local script: one shared token with the admin role. A production install does not have it."
      },
      "ingestToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "`SIEM_INGEST_TOKEN`: for log shippers and scripts. It can send events, nothing else."
      }
    },
    "responses": {
      "Problem": {
        "description": "An error, as RFC 9457 Problem Details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid-token",
              "invalid-json",
              "invalid-body",
              "conflict",
              "invalid-event",
              "invalid-rule",
              "not-found",
              "not-configured",
              "payload-too-large",
              "internal-error",
              "unauthenticated",
              "invalid-credentials",
              "mfa-required",
              "mfa-setup-required",
              "forbidden",
              "cross-site",
              "rate-limited"
            ],
            "description": "Stable; match on this."
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "ProductLink": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The product, as OpenAsy names it.",
            "examples": [
              "infrastructure"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The address people open it at.",
            "examples": [
              "https://infra.example.com"
            ]
          }
        }
      },
      "ProductList": {
        "type": "object",
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductLink"
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Level": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ]
      },
      "Version": {
        "type": "object",
        "required": [
          "product",
          "version"
        ],
        "properties": {
          "product": {
            "const": "siem"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "time",
          "host",
          "source",
          "message",
          "fields",
          "receivedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "host": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "source": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "message": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "fields": {
            "type": "object",
            "description": "Every other field, as sent.",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventList": {
        "type": "object",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "NewEvent": {
        "type": "object",
        "description": "A flat JSON object: text, numbers, true/false or null. `time` is an ISO 8601 date or milliseconds since 1970 (default: now); `host`, `source` and `message` are text and are what search and signals use. Up to 64 fields and 16 KiB.",
        "maxProperties": 64,
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "properties": {
          "time": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "number"
              }
            ]
          },
          "host": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "NewEvents": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/NewEvent"
          },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/NewEvent"
            }
          }
        ]
      },
      "EventsAccepted": {
        "type": "object",
        "required": [
          "accepted",
          "signals"
        ],
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "integer"
          },
          "signals": {
            "type": "integer",
            "description": "Signals created or counted up by these events."
          }
        }
      },
      "Rule": {
        "type": "object",
        "required": [
          "id",
          "title",
          "level",
          "enabled",
          "description",
          "tags",
          "source",
          "matches",
          "lastMatchAt",
          "lastError",
          "createdBy",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "enabled": {
            "type": "boolean"
          },
          "description": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "description": "The rule as written."
          },
          "matches": {
            "type": "integer"
          },
          "lastMatchAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "lastError": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ],
            "description": "Why the rule was left out or failed, or null."
          },
          "createdBy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RuleList": {
        "type": "object",
        "required": [
          "rules"
        ],
        "properties": {
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rule"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "NewRule": {
        "type": "object",
        "required": [
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 65536,
            "description": "Sigma YAML or JSON."
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "UpdateRule": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 65536
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "TestRule": {
        "type": "object",
        "required": [
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 65536
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "default": 1000,
            "description": "How many of the newest events to try."
          }
        }
      },
      "RuleTest": {
        "type": "object",
        "required": [
          "rule",
          "evaluated",
          "matches",
          "hosts",
          "events"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "object",
            "required": [
              "title",
              "level"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "level": {
                "$ref": "#/components/schemas/Level"
              }
            }
          },
          "evaluated": {
            "type": "integer"
          },
          "matches": {
            "type": "integer"
          },
          "hosts": {
            "type": "integer",
            "description": "Hosts the matching events came from."
          },
          "events": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        }
      },
      "Signal": {
        "type": "object",
        "required": [
          "id",
          "rule",
          "severity",
          "host",
          "status",
          "reason",
          "changedBy",
          "count",
          "firstSeen",
          "lastSeen"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ],
                "description": "Null once the rule is deleted."
              },
              "title": {
                "type": "string"
              }
            }
          },
          "severity": {
            "$ref": "#/components/schemas/Level"
          },
          "host": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "investigating",
              "closed",
              "false-positive"
            ]
          },
          "reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "changedBy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "count": {
            "type": "integer"
          },
          "firstSeen": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SignalList": {
        "type": "object",
        "required": [
          "signals"
        ],
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Signal"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "SignalDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Signal"
          },
          {
            "type": "object",
            "required": [
              "events"
            ],
            "properties": {
              "events": {
                "type": "array",
                "maxItems": 5,
                "description": "The first matching events that are still kept.",
                "items": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        ]
      },
      "SignalUpdate": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "new",
              "investigating",
              "closed",
              "false-positive"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Required for a false positive."
          }
        }
      },
      "Summary": {
        "type": "object",
        "required": [
          "events",
          "eventsLastDay",
          "lastEventAt",
          "rules",
          "open",
          "hours",
          "days"
        ],
        "additionalProperties": false,
        "properties": {
          "events": {
            "type": "integer"
          },
          "eventsLastDay": {
            "type": "integer"
          },
          "lastEventAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "rules": {
            "type": "object",
            "required": [
              "total",
              "enabled",
              "failing"
            ],
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "integer"
              },
              "enabled": {
                "type": "integer"
              },
              "failing": {
                "type": "integer",
                "description": "Rules with an error."
              }
            }
          },
          "open": {
            "type": "object",
            "required": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "properties": {
              "critical": {
                "type": "integer"
              },
              "high": {
                "type": "integer"
              },
              "medium": {
                "type": "integer"
              },
              "low": {
                "type": "integer"
              }
            },
            "description": "Open signals (new or investigating) by severity."
          },
          "hours": {
            "type": "array",
            "description": "Events in each of the last 24 hours, by the time they happened, oldest first.",
            "items": {
              "type": "object",
              "required": [
                "start",
                "events"
              ],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time",
                  "description": "The start of the hour, UTC."
                },
                "events": {
                  "type": "integer"
                }
              }
            }
          },
          "days": {
            "type": "array",
            "description": "Signals first seen on each of the last 14 days (UTC), by severity, oldest first.",
            "items": {
              "type": "object",
              "required": [
                "start",
                "signals"
              ],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date"
                },
                "signals": {
                  "type": "object",
                  "required": [
                    "critical",
                    "high",
                    "medium",
                    "low"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "critical": {
                      "type": "integer"
                    },
                    "high": {
                      "type": "integer"
                    },
                    "medium": {
                      "type": "integer"
                    },
                    "low": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
